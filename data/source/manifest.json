  "airline_query": "# SPDX-License-Identifier: MIT\n# All entities classified as airline, including instances of airline subclasses.\n# No active-status, code-presence, country, or LIMIT filter.\nSELECT DISTINCT ?airline ?name_en ?name_ja ?iata ?icao ?country ?inception ?dissolved WHERE {\n  ?airline wdt:P31/wdt:P279* wd:Q46970 .\n  OPTIONAL { ?airline rdfs:label ?name_en FILTER(LANG(?name_en) = \"en\") }\n  OPTIONAL { ?airline rdfs:label ?name_ja FILTER(LANG(?name_ja) = \"ja\") }\n  OPTIONAL { ?airline wdt:P229 ?iata }\n  OPTIONAL { ?airline wdt:P230 ?icao }\n  OPTIONAL { ?airline wdt:P17 ?country }\n  OPTIONAL { ?airline wdt:P571 ?inception }\n  OPTIONAL { ?airline wdt:P576 ?dissolved }\n}\n"
